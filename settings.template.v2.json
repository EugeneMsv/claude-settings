  "model": "sonnet",
  "fallbackModel": [
    "claude-4.6-sonnet-vertex-ai"
  ],
  "disableBundledSkills": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tmux/tmux-claude-alert.sh done"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tmux/tmux-claude-alert.sh input"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/pre-tool-gate/hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/grep-token-killer/hook.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "ai-herald@eug-msv-claude-marketplace": false,
    "commit-commands@claude-plugins-official": false,
    "jdtls-lsp@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": false,
    "claude-code-guide@eug-msv-claude-marketplace": true,
    "code-sentinel@eug-msv-claude-marketplace": true,
    "feedback-loop@eug-msv-claude-marketplace": true,
    "plan-guard@eug-msv-claude-marketplace": true,
    "datadog@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "eug-msv-claude-marketplace": {
      "source": {
        "source": "directory",
        "path": "<path-to-your-local-marketplace>"
      },
      "autoUpdate": true
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "prefersReducedMotion": true,
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "showTurnDuration": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Read-only shell inspection is allowed: grep, find, ls, cat, stat, wc, git read-only subcommands (log, status, diff, show, blame, branch)",
      "Read-only gcloud commands are allowed: list, describe, get-iam-policy, config get-value/list, logging read",
      "glab api GET requests are allowed (read-only); non-GET glab api and any glab mr write still require ask"
    ],
    "soft_deny": [
      "$defaults",
      "Never run any prod operation (prod GCP project, prod host, or prod tool) without first asking and explaining why it is needed",
      "Never run any Trino query without first asking and explaining why it is needed"
    ],
    "hard_deny": [
      "$defaults",
      "Never send repository contents to third-party code-review APIs",
      "Never allowed to do any modification (write, update, create) operations in prod environments or tools",
      "Never read or output prod secrets, credentials, access/identity tokens, or privacy-sensitive viewer/ad-targeting PII"
    ],
    "environment": [
      "$defaults",
      "Organization: <your org>. Primary use: software development",
      "Domain: <describe your domain, e.g. e-commerce, fintech, ad-tech; note any latency/compliance/PII sensitivities>",
      "Source control: monorepo <your-gitlab-or-github-host>/<group>/<repo>",
      "Environments: Dev, QA, Stg/RC, Prod; describe your own naming convention for identifying production hosts/projects",
      "Prod-host heuristic: <describe how to distinguish prod from non-prod hostnames/projects in your infra>",
      "Cloud provider: <GCP/AWS/Azure>; projects: <dev-project-id> (dev, qa), <prod-project-id> (stg, rc, canary, prod)",
      "Trusted internal domains: <list your internal domains here>",
      "Key internal services: <list your key services and their admin/API endpoints here>",
      "Tooling: CI/CD <your CI tool>; observability <your monitoring stack>; data via <your data tools>; artifacts <your artifact repo>; on-call <your on-call tool>",
      "CLIs: glab, gcloud, git"
    ]
  },
  "teamMateMode": "tmux"
}
