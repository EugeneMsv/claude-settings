# Ignore everything at root level
/*
/**/*.log
.DS_Store

# Except these directories
!/tmux
!/agents
!/skills
!/rules
!/ai-contribution-tracker/config.json
!/hooks
!/ai-contribution-tracker
ai-contribution-tracker/history
!/ai-herald
!/ai-herald/config.json
ai-herald/history
!/statusline
statusline/cache

# Except these root-level files
!/*.md
!/settings.template.json
!/settings.template.v2.json
!/tmux-git-diff.sh
!/tmux-git-status.sh

# Exclude specific sensitive files
CLAUDE.md
settings.json

# Never track .env files anywhere in this repo (secrets), even inside
# directories re-included above (e.g. skills/) — must come after the
# negations since gitignore evaluates patterns in file order.
**/.env
